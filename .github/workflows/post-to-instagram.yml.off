name: Post to Instagram (auto-processed images — articles/** only, processed branch)

on:
  push:
    paths:
      - 'articles/**'
      - 'assets/articles/**'

concurrency:
  group: post-to-instagram-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: write   # required to commit processed images & create processed branch

jobs:
  post:
    name: Post to Instagram
    runs-on: ubuntu-latest
    env:
      # content branch (source articles)
      GITHUB_REPO: seechu13/seechuragro.github.io
      GITHUB_BRANCH: staging
      # branch where processed images are stored (separate branch to avoid noisy builds)
      PROCESSED_BRANCH: processed-images
      # Path to the article JSON to post (defaults to articles/test-automation.json)
      IG_POST_JSON: articles/test-automation.json
      # Hashtag envs (only)
      HASHTAG_MAX: '30'
      HASHTAG_MIN_WORD_LEN: '3'
      EXTRA_HASHTAGS: 'seechuragro,agriculture'
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true   # allow the default GITHUB_TOKEN to be used for commits

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Validate JSON (fast fail)
        run: |
          if [ -f "${{ env.IG_POST_JSON }}" ]; then
            python -m json.tool "${{ env.IG_POST_JSON }}"
            echo "JSON valid: ${{ env.IG_POST_JSON }}"
          else
            echo "JSON not found at ${{ env.IG_POST_JSON }} — aborting"
            exit 1
          fi

      - name: Install Python deps
        run: |
          python -m pip install --upgrade pip
          pip install requests pillow

      - name: Run Instagram poster
        env:
          IG_USER_ID: ${{ secrets.IG_USER_ID }}
          IG_ACCESS_TOKEN: ${{ secrets.IG_ACCESS_TOKEN }}
          # use GITHUB_TOKEN so script can create branch and commit processed assets
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITHUB_REPO: ${{ env.GITHUB_REPO }}
          GITHUB_BRANCH: ${{ env.GITHUB_BRANCH }}
          PROCESSED_BRANCH: ${{ env.PROCESSED_BRANCH }}
          IG_POST_JSON: ${{ env.IG_POST_JSON }}
          HASHTAG_MAX: ${{ env.HASHTAG_MAX }}
          HASHTAG_MIN_WORD_LEN: ${{ env.HASHTAG_MIN_WORD_LEN }}
          EXTRA_HASHTAGS: ${{ env.EXTRA_HASHTAGS }}
        run: |
          set -euo pipefail
          echo "Posting using JSON: $IG_POST_JSON"
          python3 scripts/send_ig.py

      - name: Cleanup (no-op)
        if: always()
        run: echo "done"
