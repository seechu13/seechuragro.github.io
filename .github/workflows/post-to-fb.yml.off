name: Post to Facebook (automatic on articles/**)

# Automatically runs when any file under articles/ changes
on:
  push:
    paths:
      - 'articles/**'

jobs:
  post:
    runs-on: ubuntu-latest
    env:
      FB_PAGE_ID: ${{ secrets.FB_PAGE_ID }}
      FB_PAGE_ACCESS_TOKEN: ${{ secrets.FB_PAGE_ACCESS_TOKEN }}
      BASE_URL: ${{ secrets.BASE_URL }}
      # ---------- Added hashtag envs only ----------
      HASHTAG_MAX: '30'
      HASHTAG_MIN_WORD_LEN: '3'
      EXTRA_HASHTAGS: 'seechuragro,agriculture'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Secret presence debug
        run: |
          [ -n "${FB_PAGE_ID:-}" ] && echo "FB_PAGE_ID: PRESENT" || echo "FB_PAGE_ID: MISSING"
          [ -n "${FB_PAGE_ACCESS_TOKEN:-}" ] && echo "FB_PAGE_ACCESS_TOKEN: PRESENT" || echo "FB_PAGE_ACCESS_TOKEN: MISSING"

      - name: Install dependencies
        run: |
          sudo apt-get update -y
          sudo apt-get install -y imagemagick jq curl
          python3 -m pip install --upgrade pip
          python3 -m pip install requests Pillow

      - name: Create extractor script (safe)
        run: |
          printf '%s\n' '#!/usr/bin/env python3' > /tmp/extract_images.py
          printf '%s\n' 'import sys,json,urllib.parse' >> /tmp/extract_images.py
          printf '%s\n' 'path=sys.argv[1]' >> /tmp/extract_images.py
          printf '%s\n' 'base=sys.argv[2].rstrip("/") + "/"' >> /tmp/extract_images.py
          printf '%s\n' 'j=json.load(open(path,"r",encoding="utf-8"))' >> /tmp/extract_images.py
          printf '%s\n' 'imgs=[]' >> /tmp/extract_images.py
          printf '%s\n' 'if isinstance(j.get("images"),list) and j.get("images"): imgs=j.get("images")' >> /tmp/extract_images.py
          printf '%s\n' 'elif j.get("cover_image") is not None:' >> /tmp/extract_images.py
          printf '%s\n' '  ci=j.get("cover_image")' >> /tmp/extract_images.py
          printf '%s\n' '  if isinstance(ci,list): imgs=ci' >> /tmp/extract_images.py
          printf '%s\n' '  elif isinstance(ci,str) and ci.strip(): imgs=[ci]' >> /tmp/extract_images.py
          printf '%s\n' 'elif isinstance(j.get("media"),list) and j.get("media"): imgs=j.get("media")' >> /tmp/extract_images.py
          printf '%s\n' 'def normalize(u):' >> /tmp/extract_images.py
          printf '%s\n' '  if not u: return None' >> /tmp/extract_images.py
          printf '%s\n' '  u=u.strip()' >> /tmp/extract_images.py
          printf '%s\n' '  if u.startswith("http"): return u' >> /tmp/extract_images.py
          printf '%s\n' '  if u.startswith("/") : return urllib.parse.urljoin(base,u.lstrip("/"))' >> /tmp/extract_images.py
          printf '%s\n' '  return urllib.parse.urljoin(base,u)' >> /tmp/extract_images.py
          printf '%s\n' 'images=[normalize(u) for u in imgs if normalize(u)]' >> /tmp/extract_images.py
          printf '%s\n' 'print("EXTRACTED_IMAGES_COUNT:",len(images))' >> /tmp/extract_images.py
          printf '%s\n' 'for i,u in enumerate(images,1): print(f"IMAGE_%d: %s" % (i,u))' >> /tmp/extract_images.py
          chmod +x /tmp/extract_images.py

      - name: Find and post JSON files
        shell: bash
        run: |
          set -euo pipefail
          # Look for article JSONs (same folders you used originally)
          LIST="$(find posts -type f -name '*.json' 2>/dev/null || true) $(find .github/test-posts -type f -name '*.json' 2>/dev/null || true) $(find articles -type f -name '*.json' 2>/dev/null || true)"
          LIST=$(printf "%s\n" $LIST || true)
          if [ -z "$LIST" ]; then
            echo "No JSON files"
            exit 0
          fi
          for jf in $LIST; do
            if [ ! -f "$jf" ]; then
              echo "Skipping missing: $jf"
              continue
            fi
            echo "----------------------------------------"
            echo "Posting: $jf"
            sed -n '1,200p' "$jf" || true
            echo "--- Extracted images ---"
            python3 /tmp/extract_images.py "$jf" "${BASE_URL:-https://seechuragro.in}"
            echo "--- run send_fb.py ---"
            # Keep exact call location as before; script now reads HASHTAG envs
            python3 scripts/send_fb.py "$jf" || { echo "send_fb.py failed for $jf"; exit 1; }
            echo "----------------------------------------"
          done

      - name: Cleanup
        if: always()
        run: rm -f /tmp/extract_images.py || true
