name: Post to Instagram
on:
  push:
    branches:
      - staging
  workflow_dispatch: {}

jobs:
  detect:
    runs-on: ubuntu-latest
    outputs:
      json_files: ${{ steps.find.outputs.json_files }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - id: find
        name: Find JSON files
        run: |
          RAW1=$(find posts -type f -name '*.json' 2>/dev/null || true)
          RAW2=$(find .github/test-posts -type f -name '*.json' 2>/dev/null || true)
          RAW3=$(find articles -type f -name '*.json' 2>/dev/null || true)
          ALL="$RAW1
$RAW2
$RAW3"
          CLEAN=$(printf "%s" "$ALL" | sed '/^\s*$/d')
          if [ -z "$CLEAN" ]; then
            echo "json_files=" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          OUT=$(printf "%s" "$CLEAN" | sed ':a;N;$!ba;s/\n/<<NL>>/g')
          echo "json_files=$OUT" >> "$GITHUB_OUTPUT"

  post-instagram:
    needs: detect
    runs-on: ubuntu-latest
    env:
      IG_USER_ID: ${{ secrets.IG_USER_ID }}
      IG_ACCESS_TOKEN: ${{ secrets.IG_ACCESS_TOKEN || secrets.FB_PAGE_ACCESS_TOKEN }}
      BASE_URL: ${{ secrets.BASE_URL }}
      SLEEP_SECONDS: "0"
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Secret presence debug
        run: |
          [ -n "${IG_USER_ID:-}" ] && echo "IG_USER_ID: PRESENT" || echo "IG_USER_ID: MISSING"
          [ -n "${IG_ACCESS_TOKEN:-}" ] && echo "IG_ACCESS_TOKEN: PRESENT" || echo "IG_ACCESS_TOKEN: MISSING"

      - name: Install deps
        run: |
          sudo apt-get update -y
          sudo apt-get install -y jq curl
          python3 -m pip install --upgrade pip
          python3 -m pip install --user requests Pillow

      - name: (Optional) Safety sleep
        run: |
          if [ "${SLEEP_SECONDS}" != "0" ]; then
            echo "Sleeping ${SLEEP_SECONDS}s..."
            sleep "${SLEEP_SECONDS}"
          else
            echo "No safety sleep"
          fi

      - name: Post each JSON to Instagram (runner + debug)
        shell: bash
        run: |
          set -euo pipefail

          RAW="${{ needs.detect.outputs.json_files }}"
          if [ -z "$RAW" ]; then
            echo "No JSON files detected. Exiting."
            exit 0
          fi

          LIST=$(printf "%s" "$RAW" | sed 's/<<NL>>/\n/g')

          for jf in $LIST; do
            if [ ! -f "$jf" ]; then
              echo "Skipping missing file: $jf"
              continue
            fi

            echo "----------------------------------------"
            echo "Posting: $jf"
            echo "--- JSON preview (first 200 lines) ---"
            sed -n '1,200p' "$jf" || true

            echo "--- Extracted images ---"
            python3 - <<'PY' "$jf" "${BASE_URL:-https://seechuragro.in}"
import sys, json, urllib.parse, os
path = sys.argv[1]
base = sys.argv[2].rstrip('/') + '/'
with open(path,'r',encoding='utf-8') as f:
    j = json.load(f)
imgs = []
if isinstance(j.get('images'), list) and j.get('images'):
    imgs = j.get('images')
elif j.get('cover_image') is not None:
    ci = j.get('cover_image')
    if isinstance(ci, list):
        imgs = ci
    elif isinstance(ci, str) and ci.strip():
        imgs = [ci]
elif isinstance(j.get('media'), list) and j.get('media'):
    imgs = j.get('media')
def normalize(u):
    if not u: return None
    u=u.strip()
    if u.startswith('http://') or u.startswith('https://'):
        return u
    if u.startswith('/'):
        return urllib.parse.urljoin(base, u.lstrip('/'))
    return urllib.parse.urljoin(base, u)
norm = [normalize(u) for u in imgs if normalize(u)]
print("EXTRACTED_IMAGES_COUNT:", len(norm))
for i,u in enumerate(norm,1):
    print(f"IMAGE_{i}:", u)
PY

            echo "--- run ig.py ---"
            python3 scripts/ig.py "$jf" || { echo "ig.py failed for $jf"; exit 1; }
            echo "----------------------------------------"
          done

      - name: Cleanup
        if: always()
        run: |
          true
